# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Downloaded font and generated data matrices
# Run `python setup_assets.py` and `python indexer.py` to regenerate
assets/*
!assets/.gitkeep
data/*
!data/.gitkeep
static/*
!static/.gitkeep

# Static web front end: export_web.py output, test golden set, npm packages
web/dist/
web/tests/golden/
web/node_modules/

# IDE / OS specific files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Streamlit local secrets (config.toml holds the theme and is committed)
.streamlit/secrets.toml
